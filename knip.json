{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "viewer/public/app.js!",
    "viewer/public/prefs-init.js!",
    "checks/commit-subjects.ts!",
    "checks/file-size.ts!",
    "cli/test/preload.ts",
    "cli/test/check-harness.ts",
    "viewer/test/check-browser.ts",
    "viewer/test/render-check.ts",
    "viewer/test/shot.ts",
    "**/*.test.ts"
  ],
  "includeEntryExports": true,
  "project": [
    "cli/**/*.ts!",
    "viewer/**/*.ts!",
    "viewer/public/**/*.js!",
    "checks/**/*.ts!",
    "cli/test/**/*.ts",
    "viewer/test/**/*.ts",
    "checks/**/*.test.ts"
  ],
  "ignoreDependencies": ["mermaid"],
  "ignoreUnresolved": ["/assets/mermaid/mermaid.esm.min.mjs"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
