{
  "$schema": "./node_modules/knip/schema.json",
  "entry": ["viewer/public/app.js!", "viewer/public/prefs-init.js!", "checks/file-size.ts!"],
  "project": [
    "cli/*.ts!",
    "viewer/*.ts!",
    "viewer/public/*.js!",
    "cli/test/**/*.ts",
    "viewer/test/**/*.ts",
    "checks/*.test.ts"
  ],
  "ignoreDependencies": ["mermaid"],
  "ignoreUnresolved": ["/assets/mermaid/mermaid.esm.min.mjs"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
