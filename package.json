{
  "name": "keylight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A research, design, outline and implement workflow for coding agents, with a local artifact viewer.",
  "packageManager": "bun@1.4.5",
  "bin": {
    "keylight": "./cli/keylight.ts"
  },
  "scripts": {
    "check": "bun run --parallel --no-exit-on-error 'gate:*'",
    "gate:types": "tsc -p .",
    "gate:tests": "bun test",
    "gate:file-size": "bun checks/file-size.ts",
    "check:browser": "bun viewer/test/check-browser.ts",
    "serve": "bun cli/keylight.ts serve",
    "render-check": "bun viewer/test/render-check.ts",
    "shot": "bun viewer/test/shot.ts"
  },
  "dependencies": {
    "highlight.js": "11",
    "markdown-it": "14",
    "mermaid": "11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/bun": "^1.4.5",
    "@types/markdown-it": "^14.2.0",
    "playwright": "1",
    "typescript": "7.0.2"
  }
}
