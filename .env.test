# Loaded by `bun test` before it starts, so every git command a test runs,
# including those in the CLI's own code and its children, reads no global or
# system git settings. cli/test/preload.ts refuses to run without them.
GIT_CONFIG_GLOBAL=/dev/null
GIT_CONFIG_NOSYSTEM=1
# `bun test` runs in UTC without saying so to its children. Naming the zone
# puts them on the same day as the test that started them, at any hour.
TZ=UTC
